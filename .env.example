# model-set secrets — copy to .env and fill in.
#
#   cp .env.example .env
#
# SECRETS ONLY. Behaviour flags live in scripts/setup.sh so they are tracked in
# git; setup sources this whole file into your shell rc, so anything added here
# becomes a global environment variable in every shell you open.
#
# .env is gitignored. On a new machine, fill these by hand from your password
# manager — nothing here is recoverable from the repo.
#
# NOT here: DATABASE_URI for the postgres MCP. That is project-scoped and
# belongs in the project's own .env. See scripts/apply-local.sh.

# Context7 — documentation lookup MCP (global, all three agents).
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# Firecrawl CLI — web search, scrape, crawl.
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Sogni — image, video and music generation. Powers the sogni skill, which is
# linked into all three agents.
# https://sogni.ai
SOGNI_API_KEY=

# ---------------------------------------------------------------------------
# No key needed for the agent CLIs themselves — Claude Code, Codex and OpenCode
# all use OAuth here. Log in manually after setup:
#
#   claude          # then /login
#   codex login
#   opencode auth login
#
# The aiguide MCP requires no auth.
