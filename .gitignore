# Agent file sync backups (auto-generated)
agent_file_backups/

# ---------------------------------------------------------------------------
# LEGACY — delete this section after running scripts/migrate-from-symlink.sh
#
# The old layout symlinked whole config directories into global/<tool>/, so the
# tools wrote their runtime state inside this repo and every one of these had to
# be ignored. Under file ownership none of it lands here any more; these entries
# only matter on a machine that has not migrated yet.
# ---------------------------------------------------------------------------
