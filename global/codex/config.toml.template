# Codex CLI Configuration
# Generated by model-set setup script - do not edit directly.
# Edit config.toml.template and re-run setup.
#
# Only documented keys — verified against https://developers.openai.com/codex/config-reference
# The previous [capabilities.*] / [approvals.tools] sections were NOT part of the Codex
# config surface and were silently ignored. Command allow/deny rules now live in
# ~/.codex/rules/agents.rules (exec-policy). File protection = sandbox_mode; there is no
# per-glob file permission table.

# MODEL SETTINGS
# ------------------------------------------------------------------------------
model = "gpt-5.5"
model_reasoning_effort = "high"
personality = "pragmatic"

[features]
multi_agent = true

# APPROVALS + SANDBOX (the real permission surface)
# ------------------------------------------------------------------------------
approval_policy = "untrusted"
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = true

[tui]
notifications = true
notification_condition = "always"
notification_method = "osc9"
status_line = ["model-with-reasoning", "context-used"]

[windows]
sandbox = "elevated"

# MCP Servers - Global (always available)
# ------------------------------------------------------------------------------
[mcp_servers.context7]
command = "npx"
args = ["--offline", "-y", "@upstash/context7-mcp"]
env_vars = ["CONTEXT7_API_KEY"]          # passthrough whitelist of env var NAMES
enabled = true
default_tools_approval_mode = "auto"     # auto-approve this server's tools
