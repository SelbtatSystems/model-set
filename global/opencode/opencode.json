{
  "$schema": "https://opencode.ai/config.json",

  "plugin": ["@warp-dot-dev/opencode-warp"],

  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",

      "git *": "allow",
      "gh *": "allow",

      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",

      "docker *": "allow",
      "docker-compose *": "allow",

      "agent-browser *": "allow",
      "firecrawl *": "allow",
      "sogni-agent *": "allow",

      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "aiguide": {
      "type": "remote",
      "url": "https://mcp.tigerdata.com/docs",
      "enabled": true
    }
  }
}
