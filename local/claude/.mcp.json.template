{
  "_comment": [
    "Project-scoped MCP servers. Copied verbatim by scripts/apply-local.sh — no",
    "substitution: Claude Code expands ${VAR} from the environment at runtime, so",
    "no secret is ever written into a generated file.",
    "",
    "Set POSTGRES_DATABASE_URI in the PROJECT's .env, not model-set's. The global",
    "servers (context7, aiguide) are registered at user scope by setup.sh and are",
    "available here without being listed.",
    "",
    "Replace 'your-docker-network' with the project's compose network."
  ],
  "mcpServers": {
    "postgres": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "--network", "your-docker-network",
        "-e", "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "${POSTGRES_DATABASE_URI}"
      }
    }
  }
}
